{"qid": "I04.P1", "question": "activated abilities that require sacrificing an artifact as part of their cost", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I08.P1", "question": "a single ability that makes each opponent lose life and gains you that much life", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"contains": "Opp"}}}, {"api": "GainLife"}]}}}
{"qid": "I10.P1", "question": "creatures that both create creature tokens and have a sacrifice outlet", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": {"any": ["Token", "CopyPermanent"]}}}, {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Creature"}}}}]}}
{"qid": "I11.P1", "question": "cards that deal damage to each opponent", "query": {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayer": {"contains": "Opponent"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"contains": "Opponent"}}}}]}}
{"qid": "I12.P1", "question": "cards that return all creatures to their owners' hands", "query": {"node": {"api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}, "Origin": {"contains": "Battlefield"}, "Destination": "Hand"}}}}
{"qid": "I18.P1", "question": "cards that provide repeatable card draw every turn rather than a one-time draw", "query": {"any": [{"chain": {"from": {"kind": "T", "mode": {"any": ["Phase", "TurnBegin"]}}, "to": {"api": "Draw"}}}, {"node": {"kind": "T", "mode": {"any": ["Phase", "TurnBegin"]}, "api": "Draw"}}, {"chain": {"from": {"kind": "A", "apiKind": "AB"}, "to": {"api": "Draw"}}}, {"node": {"kind": "A", "apiKind": "AB", "api": "Draw"}}]}}
{"qid": "I22.P1", "question": "creature removal that can be cast at instant speed", "query": {"all": [{"any": [{"card": {"types": {"contains": "Instant"}}}, {"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}, {"any": [{"node": {"apiKind": "SP", "api": {"any": ["Destroy", "DealDamage", "ChangeZone", "Fight", "Sacrifice"]}, "params": {"ValidTgts": {"contains": "Creature"}}}}, {"node": {"api": {"any": ["DestroyAll", "DamageAll", "SacrificeAll"]}, "params": {"ValidCards": {"contains": "Creature"}}}}]}]}}
{"qid": "I26.P1", "question": "cards that exile things", "query": {"any": [{"node": {"api": {"any": ["ChangeZone", "ChangeZoneAll"]}, "params": {"Destination": {"contains": "Exile"}}}}, {"node": {"api": {"any": ["Dig", "DigUntil", "Mill"]}, "params": {"DestinationZone": {"contains": "Exile"}}}}]}}
{"qid": "I36.P1", "question": "sorceries with flash", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I40.P1", "question": "cards that prevent damage that would be dealt to you", "query": {"any": [{"node": {"api": "PreventDamage", "params": {"Defined": {"contains": "You"}}}}, {"node": {"api": "PreventDamage", "params": {"ValidTgts": {"contains": "You"}}}}, {"node": {"kind": "R", "params": {"Event": "DamageDone", "ValidTarget": {"contains": "You"}}}}]}}
