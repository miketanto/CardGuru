{"qid": "I04.P5", "question": "abilities you pay for by sacrificing an artifact", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I08.P5", "question": "one ability where every other player loses life and you gain that much", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"contains": "Opp"}}}, {"api": "GainLife"}]}}}
{"qid": "I10.P5", "question": "creatures that make tokens and can also sac creatures themselves", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"any": [{"node": {"api": {"any": ["Sacrifice", "SacrificeAll"]}, "params": {"SacValid": {"contains": "Creature"}}}}, {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Creature"}}}}]}]}}
{"qid": "I11.P5", "question": "spells that burn every other player at the table", "query": {"any": [{"node": {"apiKind": "SP", "api": "DamageAll", "params": {"ValidPlayers": {"contains": "Opp"}}}}, {"node": {"apiKind": "SP", "api": "DealDamage", "params": {"Defined": {"contains": "Opp"}}}}]}}
{"qid": "I12.P5", "question": "spells that send every creature back to its owner's hand", "query": {"node": {"apiKind": "SP", "api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}, "Destination": "Hand"}}}}
{"qid": "I18.P5", "question": "permanents that keep drawing you extra cards each turn", "query": {"all": [{"card": {"types": {"regex": "Creature|Artifact|Enchantment|Land|Planeswalker"}}}, {"any": [{"chain": {"from": {"kind": "T", "mode": {"any": ["Phase", "TurnBegin"]}}, "to": {"api": "Draw"}}}, {"chain": {"from": {"kind": "R", "params": {"Event": {"any": ["Draw", "DrawCards"]}}}, "to": {"api": "Draw"}}}]}]}}
{"qid": "I22.P5", "question": "spells that kill a creature and can be cast on someone else's turn", "query": {"all": [{"node": {"apiKind": "SP", "api": "Destroy", "params": {"ValidTgts": {"contains": "Creature"}}}}, {"any": [{"card": {"types": {"contains": "Instant"}}}, {"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I26.P5", "question": "cards that remove things from the game", "query": {"any": [{"node": {"api": {"any": ["ChangeZone", "ChangeZoneAll"]}, "params": {"Destination": "Exile"}}}, {"node": {"api": {"any": ["Dig", "DigUntil", "Mill"]}, "params": {"DestinationZone": {"contains": "Exile"}}}}]}}
{"qid": "I36.P5", "question": "sorcery-speed spells that have flash", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I40.P5", "question": "cards that stop damage that would hit you", "query": {"any": [{"node": {"api": "PreventDamage", "params": {"Defined": {"contains": "You"}}}}, {"node": {"api": "PreventDamage", "params": {"ValidTgts": {"contains": "You"}}}}, {"node": {"kind": "R", "params": {"Event": "DamageDone", "ValidTarget": {"contains": "You"}}}}]}}
