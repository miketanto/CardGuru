{"qid": "I04.P1", "question": "activated abilities that require sacrificing an artifact as part of their cost", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I08.P1", "question": "a single ability that makes each opponent lose life and gains you that much life", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"contains": "Opponent"}}}, {"api": "GainLife"}]}}}
{"qid": "I10.P1", "question": "creatures that both create creature tokens and have a sacrifice outlet", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Creature"}}}}]}}
{"qid": "I11.P1", "question": "cards that deal damage to each opponent", "query": {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayers": {"contains": "Opponent"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"contains": "Opponent"}}}}]}}
{"qid": "I12.P1", "question": "cards that return all creatures to their owners' hands", "query": {"node": {"api": "ChangeZoneAll", "params": {"Origin": "Battlefield", "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}}
{"qid": "I18.P1", "question": "cards that provide repeatable card draw every turn rather than a one-time draw", "query": {"any": [{"node": {"kind": "A", "apiKind": "AB", "api": "Draw"}}, {"chain": {"from": {"kind": "A", "apiKind": "AB"}, "to": {"api": "Draw"}}}, {"node": {"kind": "T", "mode": {"any": ["Phase", "TurnBegin"]}, "api": "Draw"}}, {"chain": {"from": {"kind": "T", "mode": {"any": ["Phase", "TurnBegin"]}}, "to": {"api": "Draw"}}}]}}
{"qid": "I22.P1", "question": "creature removal that can be cast at instant speed", "query": {"all": [{"any": [{"card": {"types": {"contains": "Instant"}}}, {"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}, {"any": [{"node": {"api": "Destroy", "params": {"ValidTgts": {"contains": "Creature"}}}}, {"node": {"api": "DestroyAll", "params": {"ValidCards": {"contains": "Creature"}}}}, {"node": {"api": "ChangeZone", "params": {"Destination": "Exile", "ValidTgts": {"contains": "Creature"}}}}, {"node": {"api": "ChangeZone", "params": {"Origin": "Battlefield", "Destination": {"any": ["Hand", "Library"]}, "ValidTgts": {"contains": "Creature"}}}}]}]}}
{"qid": "I26.P1", "question": "cards that exile things", "query": {"any": [{"node": {"api": "ChangeZone", "params": {"Destination": "Exile"}}}, {"node": {"api": "ChangeZoneAll", "params": {"Destination": "Exile"}}}]}}
{"qid": "I36.P1", "question": "sorceries with flash", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I40.P1", "question": "cards that prevent damage that would be dealt to you", "query": {"any": [{"node": {"api": "PreventDamage", "params": {"Defined": {"contains": "You"}}}}, {"node": {"api": "PreventDamage", "params": {"ValidTgts": {"contains": "You"}}}}, {"node": {"kind": "R", "params": {"Event": "DamageDone", "ValidTarget": {"contains": "You"}}}}]}}
