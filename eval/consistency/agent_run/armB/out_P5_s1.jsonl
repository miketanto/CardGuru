{"qid": "I04.P5", "question": "abilities you pay for by sacrificing an artifact", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I08.P5", "question": "one ability where every other player loses life and you gain that much", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": {"any": ["LoseLife", "DealDamage"]}, "params": {"Defined": {"regex": "Opponent|Player.Opponent"}}}, {"api": "GainLife", "params": {"Defined": {"contains": "You"}}}]}}}
{"qid": "I10.P5", "question": "creatures that make tokens and can also sac creatures themselves", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"any": [{"node": {"api": {"any": ["Sacrifice", "SacrificeAll"]}}}, {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Creature"}}}}]}]}}
{"qid": "I11.P5", "question": "spells that burn every other player at the table", "query": {"all": [{"node": {"apiKind": "SP"}}, {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayers": {"regex": "Opponent|Player"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"contains": "Opponent"}}}}]}]}}
{"qid": "I12.P5", "question": "spells that send every creature back to its owner's hand", "query": {"chain": {"from": {"apiKind": "SP"}, "to": {"api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}, "Origin": {"contains": "Battlefield"}, "Destination": "Hand"}}}}}
{"qid": "I18.P5", "question": "permanents that keep drawing you extra cards each turn", "query": {"all": [{"not": {"card": {"types": {"regex": "Instant|Sorcery"}}}}, {"chain": {"from": {"kind": "T", "mode": "Phase"}, "to": {"api": "Draw", "params": {"Defined": {"contains": "You"}}}}}]}}
{"qid": "I22.P5", "question": "spells that kill a creature and can be cast on someone else's turn", "query": {"all": [{"any": [{"node": {"api": "Destroy", "params": {"ValidTgts": {"contains": "Creature"}}}}, {"node": {"api": "DestroyAll", "params": {"ValidCards": {"contains": "Creature"}}}}]}, {"any": [{"card": {"types": {"contains": "Instant"}}}, {"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I26.P5", "question": "cards that remove things from the game", "query": {"any": [{"node": {"api": {"any": ["ChangeZone", "ChangeZoneAll"]}, "params": {"Destination": {"contains": "Exile"}}}}, {"node": {"params": {"DestinationZone": {"contains": "Exile"}}}}, {"node": {"kind": "R", "params": {"Event": "Moved", "Destination": {"contains": "Exile"}}}}]}}
{"qid": "I36.P5", "question": "sorcery-speed spells that have flash", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I40.P5", "question": "cards that stop damage that would hit you", "query": {"any": [{"node": {"api": "PreventDamage", "params": {"Defined": {"regex": "You|Player.You"}}}}, {"node": {"kind": "R", "params": {"Event": "DamageDone", "ValidTarget": {"contains": "You"}}}}, {"node": {"kind": "S", "mode": "DamageDone", "params": {"Prevent": "True"}}}]}}
