{"qid": "I01.P5", "question": "cards that make Treasure artifact tokens", "query": {"node": {"api": "Token", "params": {"TokenScript": {"icontains": "treasure"}}}}}
{"qid": "I02.P5", "question": "cards that shuffle your bin back into your deck", "query": {"node": {"api": {"any": ["ChangeZoneAll", "ChangeZone"]}, "params": {"Origin": {"contains": "Graveyard"}, "Destination": "Library"}}}}
{"qid": "I03.P5", "question": "cards with an ability you activate by paying life", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"contains": "PayLife"}}}}}
{"qid": "I04.P5", "question": "abilities you pay for by sacrificing an artifact", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I05.P5", "question": "creatures that draw you a card when they hit the bin", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}, "to": {"api": "Draw"}}}]}}
{"qid": "I06.P5", "question": "abilities that make creature tokens whenever a land comes into play for you", "query": {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"regex": "Land.*YouCtrl"}, "Destination": "Battlefield"}}, "to": {"api": "Token"}}}}
{"qid": "I07.P5", "question": "one ability that draws you cards and then makes you pitch cards", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "Draw"}, {"api": "Discard"}]}}}
{"qid": "I08.P5", "question": "one ability where every other player loses life and you gain that much", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"icontains": "Opponent"}}}, {"api": "GainLife", "params": {"Defined": "You"}}]}}}
{"qid": "I09.P5", "question": "creatures with flying that also have an ability triggering when they hit the bin", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"keyword": "Flying"}, {"node": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}}]}}
{"qid": "I10.P5", "question": "creatures that make tokens and can also sac creatures themselves", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"node": {"api": "Token"}}, {"hook": "sac_outlet"}]}}
{"qid": "I11.P5", "question": "spells that burn every other player at the table", "query": {"any": [{"node": {"apiKind": "SP", "api": "DamageAll", "params": {"ValidPlayers": {"icontains": "Opponent"}}}}, {"node": {"apiKind": "SP", "api": "DealDamage", "params": {"Defined": {"any": ["Player.Opponent", "Opponent"]}}}}]}}
{"qid": "I12.P5", "question": "spells that send every creature back to its owner's hand", "query": {"node": {"api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}, "Origin": "Battlefield", "Destination": "Hand"}}}}
{"qid": "I13.P5", "question": "creatures that make creature tokens without sacrificing anything", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"node": {"api": "Token"}}, {"not": {"node": {"params": {"Cost": {"contains": "Sac<"}}}}}]}}
{"qid": "I14.P5", "question": "creature removal that does not choose a target", "query": {"any": [{"node": {"api": "DestroyAll", "params": {"ValidCards": {"contains": "Creature"}}}}, {"node": {"api": "SacrificeAll", "params": {"ValidCards": {"contains": "Creature"}}}}, {"all": [{"node": {"api": "Destroy"}}, {"not": {"node": {"api": "Destroy", "params": {"ValidTgts": true}}}}]}]}}
{"qid": "I15.P5", "question": "green sorceries that search your deck for a land card", "query": {"all": [{"card": {"types": {"icontains": "Sorcery"}}}, {"card": {"manaCost": {"contains": "G"}}}, {"node": {"api": "ChangeZone", "params": {"Origin": "Library", "ChangeType": {"regex": "Land|Plains|Island|Swamp|Mountain|Forest"}}}}]}}
{"qid": "I16.P5", "question": "instants that make creature tokens", "query": {"all": [{"card": {"types": {"icontains": "Instant"}}}, {"node": {"api": "Token"}}]}}
{"qid": "I17.P5", "question": "creatures that have both deathtouch and lifelink", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"keyword": "Deathtouch"}, {"keyword": "Lifelink"}]}}
{"qid": "I18.P5", "question": "permanents that keep drawing you extra cards each turn", "query": {"all": [{"role": "card_draw:engine"}, {"not": {"card": {"types": {"regex": "Instant|Sorcery"}}}}]}}
{"qid": "I19.P5", "question": "cards with an ability letting you sacrifice a creature to pay for it", "query": {"hook": "sac_outlet"}}
{"qid": "I20.P5", "question": "cards that return creature cards from a bin into play", "query": {"any": [{"node": {"api": {"any": ["ChangeZone", "ChangeZoneAll"]}, "params": {"Origin": "Graveyard", "Destination": "Battlefield", "ChangeType": {"contains": "Creature"}}}}, {"node": {"api": "ChangeZone", "params": {"Origin": "Graveyard", "Destination": "Battlefield", "ValidTgts": {"contains": "Creature"}}}}]}}
{"qid": "I21.P5", "question": "cards that search your deck for a creature card and put it into your hand", "query": {"node": {"api": "ChangeZone", "params": {"Origin": "Library", "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}}
{"qid": "I22.P5", "question": "spells that kill a creature and can be cast on someone else's turn", "query": {"all": [{"node": {"apiKind": "SP", "api": "Destroy", "params": {"ValidTgts": {"contains": "Creature"}}}}, {"any": [{"card": {"types": {"icontains": "Instant"}}}, {"keyword": "Flash"}]}]}}
{"qid": "I23.P5", "question": "creatures you can cast on someone else's turn", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I24.P5", "question": "cards that draw you three or more cards at once", "query": {"node": {"api": "Draw", "params": {"NumCards": {"any": ["3", "4", "5", "6", "7", "8", "10"]}}}}}
{"qid": "I25.P5", "question": "creatures whose power is set by how many creature cards are in your bin", "query": {"all": [{"card": {"types": {"icontains": "Creature"}}}, {"hook": "cda_statline"}, {"card": {"oracle": {"icontains": "creature cards in your graveyard"}}}]}}
