{"qid": "I01.P1", "question": "cards that create Treasure tokens", "query": {"node": {"api": "Token", "params": {"TokenScript": {"icontains": "treasure"}}}}}
{"qid": "I02.P1", "question": "cards that shuffle your graveyard into your library", "query": {"node": {"api": {"any": ["ChangeZoneAll", "ChangeZone"]}, "params": {"Origin": {"contains": "Graveyard"}, "Destination": "Library", "Shuffle": "True"}}}}
{"qid": "I03.P1", "question": "cards with an ability that requires paying life as a cost", "query": {"node": {"kind": "A", "params": {"Cost": {"contains": "PayLife"}}}}}
{"qid": "I04.P1", "question": "activated abilities that require sacrificing an artifact as part of their cost", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I05.P1", "question": "creatures that draw you a card when they die", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}, "to": {"api": "Draw"}}}]}}
{"qid": "I06.P1", "question": "abilities that create creature tokens whenever a land enters the battlefield under your control", "query": {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Land.YouCtrl"}, "Destination": "Battlefield"}}, "to": {"api": "Token"}}}}
{"qid": "I07.P1", "question": "a single ability that draws cards and then makes you discard cards", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "Draw", "params": {"Defined": "You"}}, {"api": "Discard", "params": {"Defined": "You"}}]}}}
{"qid": "I08.P1", "question": "a single ability that makes each opponent lose life and gains you that much life", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"icontains": "Opponent"}}}, {"api": "GainLife", "params": {"Defined": "You"}}]}}}
{"qid": "I09.P1", "question": "creatures with flying that also have an ability that triggers when they die", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"keyword": "Flying"}, {"node": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}}]}}
{"qid": "I10.P1", "question": "creatures that both create creature tokens and have a sacrifice outlet", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"hook": "sac_outlet"}]}}
{"qid": "I11.P1", "question": "cards that deal damage to each opponent", "query": {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayers": {"icontains": "Opponent"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"any": ["Player.Opponent", "Opponent"]}}}}]}}
{"qid": "I12.P1", "question": "cards that return all creatures to their owners' hands", "query": {"node": {"api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}, "Origin": "Battlefield", "Destination": "Hand"}}}}
{"qid": "I13.P1", "question": "creatures that create creature tokens without sacrificing anything", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"not": {"any": [{"node": {"params": {"Cost": {"contains": "Sac<"}}}}, {"node": {"api": {"any": ["Sacrifice", "SacrificeAll"]}}}]}}]}}
{"qid": "I14.P1", "question": "creature removal that does not target", "query": {"all": [{"any": [{"node": {"api": "DestroyAll", "params": {"ValidCards": {"contains": "Creature"}}}}, {"node": {"api": "SacrificeAll", "params": {"ValidCards": {"contains": "Creature"}}}}, {"node": {"api": "Sacrifice", "params": {"SacValid": {"contains": "Creature"}}}}, {"node": {"api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}, "Origin": "Battlefield"}}}]}, {"not": {"node": {"params": {"ValidTgts": true}}}}]}}
