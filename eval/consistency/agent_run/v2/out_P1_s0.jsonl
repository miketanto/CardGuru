{"qid": "I36.P1", "question": "sorceries with flash", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I37.P1", "question": "cards that make each player draw an additional card", "query": {"any": [{"node": {"kind": "R", "params": {"Event": {"any": ["Draw", "DrawCards"]}}}}, {"chain": {"from": {"kind": {"any": ["T", "S", "R"]}}, "to": {"api": "Draw", "params": {"Defined": {"icontains": "Player"}}}}}]}}
{"qid": "I38.P1", "question": "creatures with an ability that triggers when they enter the battlefield", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Destination": "Battlefield"}}}]}}
{"qid": "I39.P1", "question": "cards that destroy target creature", "query": {"node": {"api": "Destroy", "params": {"ValidTgts": {"contains": "Creature"}}}}}
{"qid": "I40.P1", "question": "cards that prevent damage that would be dealt to you", "query": {"any": [{"node": {"api": "PreventDamage", "params": {"Defined": {"icontains": "You"}}}}, {"node": {"kind": "R", "params": {"Event": "DamageDone", "ValidTarget": {"icontains": "You"}}}}]}}
