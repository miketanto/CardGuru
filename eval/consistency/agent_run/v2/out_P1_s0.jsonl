{"qid": "I01.P1", "question": "cards that create Treasure tokens", "query": {"node": {"api": "Token", "params": {"TokenScript": {"icontains": "treasure"}}}}}
{"qid": "I02.P1", "question": "cards that shuffle your graveyard into your library", "query": {"node": {"api": {"any": ["ChangeZoneAll", "ChangeZone"]}, "params": {"Origin": {"contains": "Graveyard"}, "Destination": "Library", "Shuffle": true}}}}
{"qid": "I03.P1", "question": "cards with an ability that requires paying life as a cost", "query": {"node": {"params": {"Cost": {"regex": "PayLife"}}}}}
{"qid": "I04.P1", "question": "activated abilities that require sacrificing an artifact as part of their cost", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I05.P1", "question": "creatures that draw you a card when they die", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}, "to": {"api": "Draw"}}}]}}
{"qid": "I06.P1", "question": "abilities that create creature tokens whenever a land enters the battlefield under your control", "query": {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Land"}, "Destination": "Battlefield"}}, "to": {"api": "Token"}}}}
{"qid": "I07.P1", "question": "a single ability that draws cards and then makes you discard cards", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "Draw"}, {"api": "Discard"}]}}}
{"qid": "I08.P1", "question": "a single ability that makes each opponent lose life and gains you that much life", "query": {"all": [{"hook": "lifedrain"}, {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"icontains": "Opponent"}}}, {"api": "GainLife"}]}}]}}
{"qid": "I09.P1", "question": "creatures with flying that also have an ability that triggers when they die", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"keyword": "Flying"}, {"node": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}}]}}
{"qid": "I10.P1", "question": "creatures that both create creature tokens and have a sacrifice outlet", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"hook": "makes_tokens"}, {"hook": "sac_outlet"}]}}
{"qid": "I11.P1", "question": "cards that deal damage to each opponent", "query": {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayers": {"icontains": "Opponent"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"icontains": "Opponent"}}}}]}}
{"qid": "I12.P1", "question": "cards that return all creatures to their owners' hands", "query": {"node": {"api": "ChangeZoneAll", "params": {"Origin": {"contains": "Battlefield"}, "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}}
{"qid": "I13.P1", "question": "creatures that create creature tokens without sacrificing anything", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"not": {"node": {"params": {"Cost": {"contains": "Sac<"}}}}}, {"not": {"node": {"api": {"any": ["Sacrifice", "SacrificeAll"]}}}}]}}
{"qid": "I14.P1", "question": "creature removal that does not target", "query": {"all": [{"any": [{"node": {"api": {"any": ["DestroyAll", "SacrificeAll", "DamageAll"]}, "params": {"ValidCards": {"contains": "Creature"}}}}, {"node": {"api": "ChangeZoneAll", "params": {"ChangeType": {"contains": "Creature"}}}}, {"role": "sweepers"}]}, {"not": {"node": {"params": {"ValidTgts": {"contains": "Creature"}}}}}]}}
{"qid": "I15.P1", "question": "green sorceries that search your library for a land card", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}, "manaCost": {"contains": "G"}}}, {"node": {"api": "ChangeZone", "params": {"Origin": "Library", "ChangeType": {"regex": "Land|Plains|Island|Swamp|Mountain|Forest"}}}}]}}
{"qid": "I16.P1", "question": "instants that create creature tokens", "query": {"all": [{"card": {"types": {"contains": "Instant"}}}, {"node": {"api": "Token", "params": {"TokenScript": true}}}]}}
{"qid": "I17.P1", "question": "creatures with both deathtouch and lifelink", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"keyword": "Deathtouch"}, {"keyword": "Lifelink"}]}}
{"qid": "I18.P1", "question": "cards that provide repeatable card draw every turn rather than a one-time draw", "query": {"role": "card_draw:engine"}}
{"qid": "I19.P1", "question": "cards with an ability that lets you sacrifice a creature as a cost", "query": {"any": [{"hook": "sac_outlet"}, {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Creature"}}}}]}}
{"qid": "I20.P1", "question": "cards that return creature cards from a graveyard to the battlefield", "query": {"any": [{"hook": "reanimator"}, {"node": {"api": {"any": ["ChangeZone", "ChangeZoneAll"]}, "params": {"Origin": "Graveyard", "Destination": "Battlefield", "ChangeType": {"contains": "Creature"}}}}]}}
{"qid": "I21.P1", "question": "cards that search your library for a creature card and put it into your hand", "query": {"node": {"api": "ChangeZone", "params": {"Origin": "Library", "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}}
{"qid": "I22.P1", "question": "creature removal that can be cast at instant speed", "query": {"all": [{"role": "targeted_removal"}, {"any": [{"card": {"types": {"contains": "Instant"}}}, {"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I23.P1", "question": "creatures you can cast at instant speed", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I24.P1", "question": "cards that draw three or more cards at once", "query": {"node": {"api": "Draw", "params": {"NumCards": {"regex": "^([3-9]|[1-9][0-9]+)$"}}}}}
{"qid": "I25.P1", "question": "creatures whose power is defined by the number of creature cards in your graveyard", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"any": [{"hook": "cda_statline"}, {"card": {"pt": {"contains": "*"}}}]}, {"card": {"oracle": {"icontains": "creature cards in your graveyard"}}}]}}
{"qid": "I26.P1", "question": "cards that exile things", "query": {"node": {"api": {"any": ["ChangeZone", "ChangeZoneAll"]}, "params": {"Destination": "Exile"}}}}
{"qid": "I27.P1", "question": "efficient removal", "query": {"role": "targeted_removal"}}
{"qid": "I28.P1", "question": "cards that care about creatures dying", "query": {"hook": "cares_about_death"}}
{"qid": "I29.P1", "question": "cards that copy things", "query": {"hook": "copies_things"}}
{"qid": "I30.P1", "question": "creatures that create a token whenever you cast an instant or sorcery spell", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"chain": {"from": {"kind": "T", "mode": {"any": ["SpellCast", "SpellCastOrCopy"]}, "params": {"ValidCard": {"regex": "Instant|Sorcery"}}}, "to": {"api": "Token"}}}]}}
{"qid": "I31.P1", "question": "permanents that untap during each other player's untap step", "query": {"node": {"kind": "S", "mode": "UntapOtherPlayer"}}}
{"qid": "I32.P1", "question": "cards that let you cast spells from the top of your library", "query": {"all": [{"node": {"kind": "S", "mode": "Continuous", "params": {"MayPlay": "True"}}}, {"any": [{"node": {"params": {"AffectedZone": {"contains": "Library"}}}}, {"node": {"params": {"Affected": {"icontains": "TopLibrary"}}}}]}]}}
