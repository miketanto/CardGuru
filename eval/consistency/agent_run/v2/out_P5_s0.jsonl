{"qid": "I01.P5", "question": "cards that make Treasure artifact tokens", "query": {"node": {"api": "Token", "params": {"TokenScript": {"icontains": "treasure"}}}}}
{"qid": "I02.P5", "question": "cards that shuffle your bin back into your deck", "query": {"node": {"api": {"any": ["ChangeZoneAll", "ChangeZone"]}, "params": {"Origin": {"contains": "Graveyard"}, "Destination": "Library"}}}}
{"qid": "I03.P5", "question": "cards with an ability you activate by paying life", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"contains": "PayLife"}}}}}
{"qid": "I04.P5", "question": "abilities you pay for by sacrificing an artifact", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I05.P5", "question": "creatures that draw you a card when they hit the bin", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}, "to": {"api": "Draw"}}}]}}
{"qid": "I06.P5", "question": "abilities that make creature tokens whenever a land comes into play for you", "query": {"chain": {"from": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Land"}, "Destination": "Battlefield"}}, "to": {"api": "Token"}}}}
{"qid": "I07.P5", "question": "one ability that draws you cards and then makes you pitch cards", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "Draw"}, {"api": "Discard"}]}}}
{"qid": "I08.P5", "question": "one ability where every other player loses life and you gain that much", "query": {"hook": "lifedrain"}}
{"qid": "I09.P5", "question": "creatures with flying that also have an ability triggering when they hit the bin", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"keyword": "Flying"}, {"node": {"kind": "T", "mode": "ChangesZone", "params": {"ValidCard": {"contains": "Card.Self"}, "Origin": "Battlefield", "Destination": "Graveyard"}}}]}}
{"qid": "I10.P5", "question": "creatures that make tokens and can also sac creatures themselves", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"hook": "makes_tokens"}, {"hook": "sac_outlet"}]}}
{"qid": "I11.P5", "question": "spells that burn every other player at the table", "query": {"all": [{"card": {"types": {"regex": "Instant|Sorcery"}}}, {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayers": {"contains": "Opponent"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"contains": "Opponent"}}}}]}]}}
{"qid": "I12.P5", "question": "spells that send every creature back to its owner's hand", "query": {"all": [{"card": {"types": {"regex": "Instant|Sorcery"}}}, {"node": {"api": "ChangeZoneAll", "params": {"Origin": "Battlefield", "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}]}}
{"qid": "I13.P5", "question": "creatures that make creature tokens without sacrificing anything", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"not": {"any": [{"node": {"params": {"Cost": {"contains": "Sac<"}}}}, {"node": {"api": {"any": ["Sacrifice", "SacrificeAll"]}}}]}}]}}
{"qid": "I14.P5", "question": "creature removal that does not choose a target", "query": {"all": [{"role": "sweepers"}, {"not": {"node": {"params": {"ValidTgts": {"contains": "Creature"}}}}}]}}
{"qid": "I15.P5", "question": "green sorceries that search your deck for a land card", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}, "manaCost": {"contains": "G"}}}, {"node": {"api": "ChangeZone", "params": {"Origin": "Library", "ChangeType": {"regex": "Land|Plains|Island|Swamp|Mountain|Forest"}}}}]}}
{"qid": "I16.P5", "question": "instants that make creature tokens", "query": {"all": [{"card": {"types": {"contains": "Instant"}}}, {"node": {"api": "Token"}}]}}
{"qid": "I17.P5", "question": "creatures that have both deathtouch and lifelink", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"keyword": "Deathtouch"}, {"keyword": "Lifelink"}]}}
{"qid": "I18.P5", "question": "permanents that keep drawing you extra cards each turn", "query": {"all": [{"card": {"types": {"regex": "Creature|Artifact|Enchantment|Planeswalker|Land"}}}, {"role": "card_draw:engine"}]}}
{"qid": "I19.P5", "question": "cards with an ability letting you sacrifice a creature to pay for it", "query": {"hook": "sac_outlet"}}
{"qid": "I20.P5", "question": "cards that return creature cards from a bin into play", "query": {"hook": "reanimator"}}
{"qid": "I21.P5", "question": "cards that search your deck for a creature card and put it into your hand", "query": {"node": {"api": "ChangeZone", "params": {"Origin": "Library", "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}}
{"qid": "I22.P5", "question": "spells that kill a creature and can be cast on someone else's turn", "query": {"all": [{"any": [{"card": {"types": {"contains": "Instant"}}}, {"keyword": "Flash"}]}, {"role": "targeted_removal"}]}}
