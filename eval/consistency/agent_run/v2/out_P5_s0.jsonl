{"qid": "I28.P5", "question": "cards that care about creatures hitting the bin", "query": {"hook": "cares_about_death"}}
{"qid": "I29.P5", "question": "cards that duplicate things", "query": {"hook": "copies_things"}}
{"qid": "I30.P5", "question": "creatures that make a token whenever you cast an instant or sorcery", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"chain": {"from": {"kind": "T", "mode": {"any": ["SpellCast", "SpellCastOrCopy"]}, "params": {"ValidCard": {"regex": "Instant|Sorcery"}}}, "to": {"api": "Token"}}}]}}
