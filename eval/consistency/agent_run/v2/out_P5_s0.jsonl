{"qid": "I24.P5", "question": "cards that draw you three or more cards at once", "query": {"node": {"api": "Draw", "params": {"NumCards": {"regex": "^([3-9]|[1-9][0-9]+)$"}}}}}
{"qid": "I25.P5", "question": "creatures whose power is set by how many creature cards are in your bin", "query": {"all": [{"card": {"types": {"contains": "Creature"}, "oracle": {"icontains": "creature cards in your graveyard"}}}, {"hook": "cda_statline"}]}}
