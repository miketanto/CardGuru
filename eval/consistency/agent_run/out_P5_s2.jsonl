{"qid": "I04.P5", "question": "abilities you pay for by sacrificing an artifact", "query": {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Artifact"}}}}}
{"qid": "I08.P5", "question": "one ability where every other player loses life and you gain that much", "query": {"chain": {"from": {"kind": {"any": ["A", "T", "S", "R"]}}, "to": [{"api": "LoseLife", "params": {"Defined": {"regex": "Opp"}}}, {"api": "GainLife"}]}}}
{"qid": "I10.P5", "question": "creatures that make tokens and can also sac creatures themselves", "query": {"all": [{"card": {"types": {"contains": "Creature"}}}, {"node": {"api": "Token"}}, {"any": [{"node": {"api": {"any": ["Sacrifice", "SacrificeAll"]}, "params": {"SacValid": {"contains": "Creature"}}}}, {"node": {"kind": "A", "apiKind": "AB", "params": {"Cost": {"regex": "Sac<[^>]*Creature"}}}}]}]}}
{"qid": "I11.P5", "question": "spells that burn every other player at the table", "query": {"all": [{"card": {"types": {"regex": "Instant|Sorcery"}}}, {"any": [{"node": {"api": "DamageAll", "params": {"ValidPlayers": {"regex": "Opponent|Opp"}}}}, {"node": {"api": "DealDamage", "params": {"Defined": {"regex": "Opponent|Opp"}}}}]}]}}
{"qid": "I12.P5", "question": "spells that send every creature back to its owner's hand", "query": {"all": [{"card": {"types": {"regex": "Instant|Sorcery"}}}, {"node": {"api": "ChangeZoneAll", "params": {"Origin": {"contains": "Battlefield"}, "Destination": "Hand", "ChangeType": {"contains": "Creature"}}}}]}}
{"qid": "I18.P5", "question": "permanents that keep drawing you extra cards each turn", "query": {"all": [{"not": {"card": {"types": {"regex": "Instant|Sorcery"}}}}, {"chain": {"from": {"kind": "T", "mode": "Phase"}, "to": {"api": "Draw"}}}]}}
{"qid": "I22.P5", "question": "spells that kill a creature and can be cast on someone else's turn", "query": {"all": [{"node": {"apiKind": "SP", "api": {"any": ["Destroy", "ChangeZone"]}, "params": {"ValidTgts": {"contains": "Creature"}}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I26.P5", "question": "cards that remove things from the game", "query": {"any": [{"node": {"api": "ChangeZone", "params": {"Destination": "Exile"}}}, {"node": {"api": "ChangeZoneAll", "params": {"Destination": "Exile"}}}]}}
{"qid": "I36.P5", "question": "sorcery-speed spells that have flash", "query": {"all": [{"card": {"types": {"contains": "Sorcery"}}}, {"any": [{"keyword": "Flash"}, {"node": {"kind": "S", "mode": "CastWithFlash"}}]}]}}
{"qid": "I40.P5", "question": "cards that stop damage that would hit you", "query": {"any": [{"node": {"api": "PreventDamage", "params": {"Defined": {"regex": "You"}}}}, {"node": {"api": "PreventDamage"}}, {"node": {"kind": "R", "params": {"Event": "DamageDone"}}}]}}
